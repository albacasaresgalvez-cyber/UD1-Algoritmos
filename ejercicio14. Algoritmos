Algoritmo ejercicio14
	Definir n, decenas, unidades, invertido Como Entero
    Escribir "Introduce un número de dos cifras:"
    Leer n
    decenas <- trunc(n / 10)
    unidades <- n MOD 10
    invertido <- unidades * 10 + decenas
    Escribir "El número invertido es: ", invertido
FinAlgoritmo
